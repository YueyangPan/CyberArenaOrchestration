# Copy to .env (gitignored) and fill in real values.
#
# Default setup routes every team's Claude agent through one third-party API
# router (e.g. https://app-us.ppapi.ai/v1). The router URL becomes
# ANTHROPIC_BASE_URL inside each team's dev container; the key becomes
# ANTHROPIC_API_KEY. Claude Code picks both up at launch.

# Use the router's API root (no /v1 suffix). Claude Code appends
# /v1/messages itself; including /v1 here would produce /v1/v1/messages → 404.
API_ROUTER_BASE=https://app-us.ppapi.ai
API_ROUTER_KEY=

# If you ever want per-team keys instead (e.g. for budget isolation), switch
# game.yaml's `api_key` to ${ANTHROPIC_API_KEY_TEAM1} / _TEAM2 and uncomment:
# ANTHROPIC_API_KEY_TEAM1=
# ANTHROPIC_API_KEY_TEAM2=
